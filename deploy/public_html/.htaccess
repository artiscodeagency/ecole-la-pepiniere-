# La Pépinière — routing (React site, React admin, Laravel API).
Options -MultiViews -Indexes +SymLinksIfOwnerMatch
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Laravel: API, Sanctum, per-article share pages (meta tags).
    RewriteRule ^(api|sanctum)(/.*)?$ index.php [L]
    RewriteRule ^up/?$ index.php [L]
    RewriteRule ^(robots\.txt|sitemap\.xml)$ index.php [L]
    RewriteRule ^actualites/[^/]+/?$ index.php [L]

    # Uploaded media (symlink to persistent storage): real files only.
    RewriteRule ^media/ - [L]

    # Existing built files.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Admin SPA.
    RewriteRule ^admin(/.*)?$ admin.html [L]

    # Public SPA.
    RewriteRule ^ index.html [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(js|css|webp|jpg|png|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
