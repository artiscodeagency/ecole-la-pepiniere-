# Template only. Copy to ~/domains/lapepiniere.artischools.com/app/shared/.env on the server (chmod 600) and fill the blanks there. Never commit real values.
APP_NAME="La Pépinière"
APP_ENV=production
APP_KEY=            # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://lapepiniere.artischools.com
FRONTEND_URL=https://lapepiniere.artischools.com
APP_LOCALE=fr
LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=        # from hPanel > Databases
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=lapepiniere.artischools.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=lapepiniere.artischools.com

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Built site index (served with each /actualites/{slug} share page).
SPA_INDEX_PATH=/home/u133979320/domains/lapepiniere.artischools.com/public_html/index.html
